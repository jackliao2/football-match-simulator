# Optional AI commentary. The simulator works without these.
# Volcano Ark / Seed 2.0 Mini (OpenAI-compatible endpoint).
AI_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=ep-your-endpoint-id
AI_DISABLE_THINKING=true
AI_TIMEOUT_MS=20000

# Per warm server instance. Use a distributed limiter before high-volume launch.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX=6
AI_RATE_LIMIT_WINDOW_MS=600000

# Cache deterministic analysis/report responses to avoid paying twice.
AI_CACHE_ENABLED=true
AI_ANALYSIS_CACHE_TTL_SECONDS=86400
AI_COMMENTARY_CACHE_TTL_SECONDS=604800

# SpaceXAI / xAI fallback if AI_API_KEY is empty
XAI_API_KEY=

# Canonical site URL for sitemap, robots and Open Graph
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_DOMAIN=example.com
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com
